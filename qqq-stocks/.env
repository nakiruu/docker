# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control — it is in .gitignore.

INFLUXDB_USERNAME=admin
# Use a strong, unique password (min 16 chars required by InfluxDB 2.x)
INFLUXDB_PASSWORD=CHANGE_ME_strong_password_here
# Generate with: openssl rand -hex 32
INFLUXDB_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32
INFLUXDB_ORG=stocks
INFLUXDB_BUCKET=qqq
# Poll interval in seconds — minimum 30 enforced by the collector
POLL_INTERVAL=60
