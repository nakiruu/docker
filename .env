# Change this before any real use — must be a long random string
SUPERSET_SECRET_KEY=swap-me-for-something-long-and-random

# Superset admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# Superset image version
SUPERSET_VERSION=4.1.0

# Host port for the Superset UI
SUPERSET_PORT=8088

# MariaDB root password (internal; not exposed)
MARIADB_ROOT_PASSWORD=rootpassword
